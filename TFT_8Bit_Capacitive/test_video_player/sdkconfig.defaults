CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=24576

# FATFS Long Filename support
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_FS_LOCK=0
CONFIG_FATFS_TIMEOUT_MS=10000

# LVGL 9
CONFIG_LV_COLOR_DEPTH_16=y

# FreeRTOS 1000 Hz tick rate for precise video cadence
CONFIG_FREERTOS_HZ=1000

# SD Protocol Layer: disable SDIO support to prevent CMD52 error 0x104 on standard MicroSD
CONFIG_SD_ENABLE_SDIO_SUPPORT=n

