menu "App perf"

    config APP_PERF_AUTOTEST
        bool "Habilitar modo autotest de rendimiento"
        default n
        help
            Habilita la ejecucion automatica de pruebas de rendimiento sobre los archivos AVI en la MicroSD.

    config APP_PERF_SECONDS_PER_TRACK
        int "Segundos por pista en autotest"
        default 60
        help
            Tiempo total en segundos para probar cada video AVI, dividido en 3 escenarios iguales (hidden, osd, seek).

    config APP_UI_REFRESH_MS
        int "Periodo de refresco de UI en milisegundos"
        default 250
        help
            Intervalo en milisegundos del timer periodico de LVGL para refrescar estado de UI (Obs O1).

    config APP_SD_FREQ_KHZ
        int "Frecuencia SPI de la MicroSD en kHz"
        default 20000
        range 400 40000
        help
            Frecuencia máxima del bus SPI para la tarjeta MicroSD (20000, 26000 o 40000 kHz).

    config APP_TE_SYNC
        bool "Sincronizacion de envio con pin TE del display"
        default y
        help
            Sincroniza el envio de cada fotograma de video al display con el flanco de subida del pin TE (GPIO 7).

    config APP_LCD_B1_P1
        hex "Parametro 1 de FRMCTR1 (0xB1) ILI9488"
        default 0x80
        help
            Primer parametro de FRMCTR1 (0xB1): bits [7:4] FRS[3:0], bits [1:0] DIVA[1:0].
            Original 60 Hz: 0xA0. Ajuste 45-48 Hz: 0x80.

    config APP_LCD_B1_P2
        hex "Parametro 2 de FRMCTR1 (0xB1) ILI9488"
        default 0x11
        help
            Segundo parametro de FRMCTR1 (0xB1): bits [4:0] RTNA[4:0] (relojes por linea).
            Original 60 Hz: 0x11 (17 relojes).

endmenu


