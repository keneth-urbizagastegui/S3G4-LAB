  (text "1 · Entrada: J101, divisor ÷100, rama ×1 y réplica"
    (at 15.24 30.48 0)
    (effects (font (size 2.54 2.54) (bold yes)) (justify left bottom))
    (uuid "7624a1cb-bf23-4058-bd69-cc24b5afa70f")
  )
  (text "3 · Sujeción D101, acoplo SW101, C_AC, R_BIAS y R_PROT"
    (at 238.76 30.48 0)
    (effects (font (size 2.54 2.54) (bold yes)) (justify left bottom))
    (uuid "f683d525-323c-45d9-8884-fbe1103884a9")
  )
  (text "4 · Buffer U101"
    (at 368.3 30.48 0)
    (effects (font (size 2.54 2.54) (bold yes)) (justify left bottom))
