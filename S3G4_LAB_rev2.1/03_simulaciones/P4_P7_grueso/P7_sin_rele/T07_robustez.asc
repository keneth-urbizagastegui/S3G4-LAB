Version 4.1
SHEET 1 1900 1400
TEXT 48 32 Left 2 ;T07 P7: 200 extremos deterministas de R/C/parasitarias; escala 500mV/div.
TEXT 48 56 Left 2 ;Sin criterio. AC y ganancia DC; step2us_proxy no sustituye T03 y queda como duda explicita.
TEXT 48 96 Left 2 !.include ..\comun\rev21_comun.inc
TEXT 48 120 Left 2 !.param RUN=0
TEXT 48 144 Left 2 !.param WC=1+0.05*sin(RUN*12.9898+0.7)
TEXT 48 168 Left 2 !.param WR=1+0.01*sin(RUN*78.233+1.3)
TEXT 48 192 Left 2 !.param WPAR=1+0.60*sin(RUN*39.425+2.1)
TEXT 48 216 Left 2 !Vin VS 0 AC 1
TEXT 48 240 Left 2 !Rsrc VS BNC {50*WR}
TEXT 48 264 Left 2 !Cbnc BNC 0 {CBNC*WPAR}
TEXT 48 288 Left 2 !XR VP VN RAILS
TEXT 48 312 Left 2 !XF BNC PRE VP VN FRONT_P7 POS=200
TEXT 48 336 Left 2 !XC PRE SAL SALF VP VN COMMON TAP=1 GFIX=100
TEXT 48 360 Left 2 !.step param RUN 1 200 1
TEXT 48 384 Left 2 !.ac dec 30 10 10Meg
TEXT 48 408 Left 2 !.meas ac p7_wc_gdc FIND mag(V(SAL)) AT=100
TEXT 48 432 Left 2 !.meas ac p7_wc_g100k FIND mag(V(SAL)) AT=100k
TEXT 48 456 Left 2 !.meas ac p7_wc_g1m5 FIND mag(V(SAL)) AT=1.5Meg
TEXT 48 480 Left 2 !.meas ac p7_wc_peak MAX mag(V(SAL)) FROM=10 TO=10Meg
TEXT 48 504 Left 2 !.meas ac p7_wc_step2us_proxy PARAM 100*abs(p7_wc_peak/p7_wc_gdc-1)
