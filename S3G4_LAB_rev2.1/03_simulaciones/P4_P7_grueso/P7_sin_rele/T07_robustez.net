* C:\Users\Keneth\Desktop\S3G4 LAB\S3G4_LAB_rev2.1\03_simulaciones\P4_P7_grueso\P7_sin_rele\T07_robustez.asc
* Generated by LTspice 26.0.2 for Windows.
* T07 P7: 200 extremos deterministas de R/C/parasitarias; escala 500mV/div.
* Sin criterio. AC y ganancia DC; step2us_proxy no sustituye T03 y queda como duda explicita.
.include ..\comun\rev21_comun.inc
.param RUN=0
.param WC=1+0.05*sin(RUN*12.9898+0.7)
.param WR=1+0.01*sin(RUN*78.233+1.3)
.param WPAR=1+0.60*sin(RUN*39.425+2.1)
Vin VS 0 AC 1
Rsrc VS BNC {50*WR}
Cbnc BNC 0 {CBNC*WPAR}
XR VP VN RAILS
XF BNC PRE VP VN FRONT_P7 POS=200
XC PRE SAL SALF VP VN COMMON TAP=1 GFIX=100
.step param RUN 1 200 1
.ac dec 30 10 10Meg
.meas ac p7_wc_gdc FIND mag(V(SAL)) AT=100
.meas ac p7_wc_g100k FIND mag(V(SAL)) AT=100k
.meas ac p7_wc_g1m5 FIND mag(V(SAL)) AT=1.5Meg
.meas ac p7_wc_peak MAX mag(V(SAL)) FROM=10 TO=10Meg
.meas ac p7_wc_step2us_proxy PARAM 100*abs(p7_wc_peak/p7_wc_gdc-1)
.backanno
.end
