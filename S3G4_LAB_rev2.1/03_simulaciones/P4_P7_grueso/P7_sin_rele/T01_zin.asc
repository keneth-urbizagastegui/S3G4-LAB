Version 4.1
SHEET 1 1900 1400
TEXT 48 32 Left 2 ;T01 P7: Zin/Cin con fina y gruesa seleccionadas.
TEXT 48 56 Left 2 ;C1: 1Mohm +/-2%. C2: 10..30pF y diferencia <=2pF.
TEXT 48 96 Left 2 !.include ..\comun\rev21_comun.inc
TEXT 48 120 Left 2 !VF SRCF 0 AC 1
TEXT 48 144 Left 2 !BIF SRCF BNCF I=V(SRCF,BNCF)/1u
TEXT 48 168 Left 2 !CbncF BNCF 0 {CBNC}
TEXT 48 192 Left 2 !XRF VPF VNF RAILS
TEXT 48 216 Left 2 !XP7F BNCF OUTF VPF VNF FRONT_P7 POS=2
TEXT 48 240 Left 2 !VG SRCG 0 AC 1
TEXT 48 264 Left 2 !BIG SRCG BNCG I=V(SRCG,BNCG)/1u
TEXT 48 288 Left 2 !CbncG BNCG 0 {CBNC}
TEXT 48 312 Left 2 !XRG VPG VNG RAILS
TEXT 48 336 Left 2 !XP7G BNCG OUTG VPG VNG FRONT_P7 POS=200
TEXT 48 360 Left 2 !.ac dec 100 10 10Meg
TEXT 48 384 Left 2 !.meas ac p7_fina_zin100 FIND mag(V(BNCF)/I(BIF)) AT=100
TEXT 48 408 Left 2 !.meas ac p7_fina_cin1m FIND abs(im(I(BIF)/V(BNCF)))/(2*pi*1Meg) AT=1Meg
TEXT 48 432 Left 2 !.meas ac p7_gruesa_zin100 FIND mag(V(BNCG)/I(BIG)) AT=100
TEXT 48 456 Left 2 !.meas ac p7_gruesa_cin1m FIND abs(im(I(BIG)/V(BNCG)))/(2*pi*1Meg) AT=1Meg
