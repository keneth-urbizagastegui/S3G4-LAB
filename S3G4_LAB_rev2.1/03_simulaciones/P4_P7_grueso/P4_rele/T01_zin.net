* C:\Users\Keneth\Desktop\S3G4 LAB\S3G4_LAB_rev2.1\03_simulaciones\P4_P7_grueso\P4_rele\T01_zin.asc
* Generated by LTspice 26.0.2 for Windows.
* T01 P4: Zin y Cin, posiciones x1 y /100. Fuente ideal AC 1.
* C1: |Zin|100Hz=1Mohm +/-2%. C2: Cin=10..30pF y diferencia <=2pF.
.include ..\comun\rev21_comun.inc
Vx1 SRC1 0 AC 1
BIX1 SRC1 BNC1 I=V(SRC1,BNC1)/1u
Cbnc1 BNC1 0 {CBNC}
XRAIL1 VP1 VN1 RAILS
XP41 BNC1 OUT1 VP1 VN1 FRONT_P4 POS=1
Vd100 SRC100 0 AC 1
BID100 SRC100 BNC100 I=V(SRC100,BNC100)/1u
Cbnc100 BNC100 0 {CBNC}
XRAIL100 VP100 VN100 RAILS
XP4100 BNC100 OUT100 VP100 VN100 FRONT_P4 POS=100
.ac dec 100 10 10Meg
.meas ac p4_x1_zin100 FIND mag(V(BNC1)/I(BIX1)) AT=100
.meas ac p4_x1_cin1m FIND abs(im(I(BIX1)/V(BNC1)))/(2*pi*1Meg) AT=1Meg
.meas ac p4_d100_zin100 FIND mag(V(BNC100)/I(BID100)) AT=100
.meas ac p4_d100_cin1m FIND abs(im(I(BID100)/V(BNC100)))/(2*pi*1Meg) AT=1Meg
.backanno
.end
