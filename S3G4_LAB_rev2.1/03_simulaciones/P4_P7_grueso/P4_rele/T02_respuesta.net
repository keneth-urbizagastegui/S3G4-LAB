* Generated by LTspice 26.0.2 for Windows.
* T02 P4: cuatro escalas; SAL antes del filtro ideal.
* C3: ganancia +/-1%. C4: plana <=1%, perdida1.5MHz<=0.5dB, pico<=0.2dB.
.include ..\comun\rev21_comun.inc
Vs5 VSs5 0 AC 1
Rsrcs5 VSs5 BNCs5 50
Cbncs5 BNCs5 0 {CBNC}
XRs5 VPs5 VNs5 RAILS
XFs5 BNCs5 PREs5 VPs5 VNs5 FRONT_P4 POS=1
XCs5 PREs5 SALs5 SALFs5 VPs5 VNs5 COMMON TAP=1 GFIX=50
Vs200 VSs200 0 AC 1
Rsrcs200 VSs200 BNCs200 50
Cbncs200 BNCs200 0 {CBNC}
XRs200 VPs200 VNs200 RAILS
XFs200 BNCs200 PREs200 VPs200 VNs200 FRONT_P4 POS=1
XCs200 PREs200 SALs200 SALFs200 VPs200 VNs200 COMMON TAP=40 GFIX=50
Vs500 VSs500 0 AC 1
Rsrcs500 VSs500 BNCs500 50
Cbncs500 BNCs500 0 {CBNC}
XRs500 VPs500 VNs500 RAILS
XFs500 BNCs500 PREs500 VPs500 VNs500 FRONT_P4 POS=100
XCs500 PREs500 SALs500 SALFs500 VPs500 VNs500 COMMON TAP=1 GFIX=50
Vs5v VSs5v 0 AC 1
Rsrcs5v VSs5v BNCs5v 50
Cbncs5v BNCs5v 0 {CBNC}
XRs5v VPs5v VNs5v RAILS
XFs5v BNCs5v PREs5v VPs5v VNs5v FRONT_P4 POS=100
XCs5v PREs5v SALs5v SALFs5v VPs5v VNs5v COMMON TAP=10 GFIX=50
.ac dec 80 10 100Meg
.meas ac p4_s5_g100 FIND mag(V(SALs5)) AT=100
.meas ac p4_s5_g100k FIND mag(V(SALs5)) AT=100k
.meas ac p4_s5_g1m5 FIND mag(V(SALs5)) AT=1.5Meg
.meas ac p4_s5_gmax MAX mag(V(SALs5)) FROM=10 TO=100k
.meas ac p4_s5_gmin MIN mag(V(SALs5)) FROM=10 TO=100k
.meas ac p4_s5_peak MAX mag(V(SALs5)) FROM=10 TO=100Meg
.meas ac p4_s5_f3 WHEN mag(V(SALs5))=50/sqrt(2) FALL=1
.meas ac p4_s200_g100 FIND mag(V(SALs200)) AT=100
.meas ac p4_s200_g100k FIND mag(V(SALs200)) AT=100k
.meas ac p4_s200_g1m5 FIND mag(V(SALs200)) AT=1.5Meg
.meas ac p4_s200_gmax MAX mag(V(SALs200)) FROM=10 TO=100k
.meas ac p4_s200_gmin MIN mag(V(SALs200)) FROM=10 TO=100k
.meas ac p4_s200_peak MAX mag(V(SALs200)) FROM=10 TO=100Meg
.meas ac p4_s200_f3 WHEN mag(V(SALs200))=1.25/sqrt(2) FALL=1
.meas ac p4_s500_g100 FIND mag(V(SALs500)) AT=100
.meas ac p4_s500_g100k FIND mag(V(SALs500)) AT=100k
.meas ac p4_s500_g1m5 FIND mag(V(SALs500)) AT=1.5Meg
.meas ac p4_s500_gmax MAX mag(V(SALs500)) FROM=10 TO=100k
.meas ac p4_s500_gmin MIN mag(V(SALs500)) FROM=10 TO=100k
.meas ac p4_s500_peak MAX mag(V(SALs500)) FROM=10 TO=100Meg
.meas ac p4_s500_f3 WHEN mag(V(SALs500))=0.5/sqrt(2) FALL=1
.meas ac p4_s5v_g100 FIND mag(V(SALs5v)) AT=100
.meas ac p4_s5v_g100k FIND mag(V(SALs5v)) AT=100k
.meas ac p4_s5v_g1m5 FIND mag(V(SALs5v)) AT=1.5Meg
.meas ac p4_s5v_gmax MAX mag(V(SALs5v)) FROM=10 TO=100k
