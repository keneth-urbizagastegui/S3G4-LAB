* S7 integration of immutable S2b-S6; no dummy U103B load.
.include "ch1_comun_s6.inc"
.param R_SER_S7=470 C_COMMON_S7=3p C_GAIN_S7=1p
.param RFILT1_S7=1.11k RFILT2_S7=499
.param CFILT1_S7=56p CGILT1_S7=47p CFILT2_S7=220p CGILT2_S7=56p
.param CPCB_S7=1p C_FB_S7=1p C_MID_S7=1u R_VCHECK_S7=1k
.subckt SK_S7 IN OUT VP VN IP IM params: RA=1k RB=1k CF=100p CG=100p
R1 IN MID {RA}
R2 MID PLUS {RB}
C1 MID OUT {CF}
C2 PLUS 0 {CG}
CPCB PLUS 0 {CPCB_S7}
VIP PLUS IP 0
VIM OUT IM 0
VCCP VP VPP 0
VCCN VN VNN 0
XAMP IP IM VPP VNN OUT AD8038
.ends SK_S7
.subckt CHANNEL_S7 BNC PIN VP VN VDDA VREF DAC params: POS=1 CODE=0
XFE BNC RAWIN VP VN M TAP RSM X1 EQ SEL B T2 FRONT_S2B POS={POS} CPL=0
VI101 RAWIN BI 0
VIM101 BO U101M 0
VIP101 VP VP101 0
VIN101 VN VN101 0
X101 BI U101M BO_DRIVE VP101 VN101 OPA810
VOUT101 BO_DRIVE BO 0
XLAD BO Y1 Y2 Y3 Y4 Y5 LADDER_S3
RVCHECK Y7 0 {R_VCHECK_S7}
XMUX BO Y1 Y2 Y3 Y4 Y5 0 Y7 COMMON A0 A1 A2 MVP MVN MUX_S3 DYNAMIC=0
VMUXP VP MVP 0
VMUXN VN MVN 0
VA0 A0 0 {5*mod(CODE,2)}
VA1 A1 0 {5*mod(floor(CODE/2),2)}
VA2 A2 0 {5*floor(CODE/4)}
CPCB COMMON 0 {C_COMMON_S7}
VIA COMMON SERA 0
VIB OA SERB 0
XPROTA SERA IPA IMA PROTECT_BAV99 R_SER={R_SER_S7}
XPROTB SERB IPB IMB PROTECT_BAV99 R_SER={R_SER_S7}
VIMA MA IMA 0
VIMB MB IMB 0
VIPA VP VPA 0
VINA VN VNA 0
VIPB VP VPB 0
VINB VN VNB 0
X103A IPA IMA VPA VNA OA AD8038
X103B IPB IMB VPB VNB OUT AD8038
RFA OA MA {RF1}
RGA MA 0 {RG1}
CMA MA 0 {C_GAIN_S7}
RFB OUT MB {RF2}
RGB MB 0 {RG2}
CMB MB 0 {C_GAIN_S7}
* Real load of U103B is first SK section, no RLOAD/CLOAD.
X105A OUT OA105 VP VN IPA105 IMA105 SK_S7 RA={RFILT1_S7} RB={RFILT1_S7} CF={CFILT1_S7} CG={CGILT1_S7}
X105B OA105 FILTEROUT VP VN IPB105 IMB105 SK_S7 RA={RFILT2_S7} RB={RFILT2_S7} CF={CFILT2_S7} CG={CGILT2_S7}
RT VREF VM {RT_MID}
RB VM 0 {RB_MID}
CMID VM 0 {C_MID_S7}
RIN FILTEROUT SUM {R_IN_S4}
ROFF DAC SUM {R_OFF_S4}
RF O SUM {R_F_S4}
CF O SUM {C_FB_S7}
CSUM SUM 0 {C_SUM_S4}
VIP VM IP 0
VIM SUM IM 0
VCC VDDA VCC 0
XAMP IP IM O VCC 0 VDDA OPA836_S4_ESD
RADC O PIN {R_ADC_S4}
CADC PIN 0 {C_ADC_S4}
CPAD PIN 0 {CPAD_S6}
.ends CHANNEL_S7
