VOSA IPA IPAR {VOA}
VOSB IPB IPBR {VOB}
VIMA MA IMA 0
VIMB MB IMB 0
VIPA VP VPA 0
VINA VN VNA 0
VIPB VP VPB 0
VINB VN VNB 0
X103A IPAR IMA VPA VNA OA AMP_S9 KIND={AMP}
