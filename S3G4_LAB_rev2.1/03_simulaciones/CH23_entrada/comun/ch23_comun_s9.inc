X105A OUT OA105 VP VN IPA105 IMA105 SK_S9 RA={F1} RB={F1} CF={CFILT1_S7} CG={CGILT1_S7} VOS={VOFA} AMP={AMP}
X105B OA105 FILTEROUT VP VN IPB105 IMB105 SK_S9 RA={F2} RB={F2} CF={CFILT2_S7} CG={CGILT2_S7} VOS={VOFB} AMP={AMP}
RT VREF VM {RT_MID}
